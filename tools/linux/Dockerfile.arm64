# Dockerfile for building cumm on ARM64 (aarch64) with CUDA 13 support
# Designed for NVIDIA DGX Spark (GB10, sm_120) systems

FROM nvcr.io/nvidia/cuda:13.0.1-devel-ubuntu24.04 AS base

ARG PYTHON_VERSION=3.12

RUN echo exit 0 > /usr/sbin/policy-rc.d

# Install system dependencies including Python
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    wget \
    ca-certificates \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create python symlink
RUN ln -sf /usr/bin/python3 /usr/bin/python
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Upgrade pip
RUN python3 -m pip install --no-cache-dir  --upgrade setuptools

# cumm build dependencies 
RUN pip install --no-cache-dir  \
    "pccm>=0.4.15" \
    "ccimport>=0.4.4" \
    "pybind11>=2.6.0" \
    fire \
    numpy \
    sympy \
    ninja

WORKDIR /cumm

# Environment for CUDA compilation targeting sm_120 (Spark/GB10)
ENV FORCE_CUDA=1
ENV CUMM_CUDA_VERSION=13.0
ENV CUMM_CUDA_ARCH_LIST="12.0+PTX"
ENV CUMM_DISABLE_JIT=1

# CUDA paths
ENV PATH=/usr/local/cuda/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

CMD ["/bin/bash"]
